# Токен от @BotFather. Обязательно.
CARBOT_BOT_TOKEN=123456:AA...

# Ограничить бота конкретными чатами (через запятую). Пусто = работает везде,
# куда его добавили. Узнать id чата: команда /chatid в этом чате.
CARBOT_ALLOWED_CHATS=

# --- База ---------------------------------------------------------------------
# Встроенный режим: SurrealDB живёт прямо в процессе бота, данные в файле.
CARBOT_DB_URL=surrealkv://./data/carbot.db
# Отдельный сервер, если захочется:
# CARBOT_DB_URL=ws://localhost:8000/rpc
# CARBOT_DB_USER=root
# CARBOT_DB_PASSWORD=root
CARBOT_DB_NAMESPACE=carbot
CARBOT_DB_DATABASE=carbot

# --- Поведение ----------------------------------------------------------------
CARBOT_TIMEZONE=Europe/Moscow
CARBOT_CURRENCY=₽

# Границы правдоподобной траты, рубли
CARBOT_MIN_AMOUNT=10
CARBOT_MAX_AMOUNT=5000000

# Сколько секунд висит неотвеченный вопрос «На тачку?» перед автоудалением
CARBOT_PENDING_TTL=600

# Пороги, после которых 🫡 сменяется на 🔥 и 💀
CARBOT_BIG_EXPENSE=10000
CARBOT_HUGE_EXPENSE=50000

# Сколько подтверждений нужно, чтобы новое слово попало в словарь чата
CARBOT_LEARN_THRESHOLD=2

# Когда присылать итоги прошлого месяца
CARBOT_REPORT_DAY=1
CARBOT_REPORT_HOUR=12
CARBOT_REPORT_MINUTE=0

# Тянуть аватарки участников в картинку (иначе кружки с инициалами)
CARBOT_AVATARS_ENABLED=true
